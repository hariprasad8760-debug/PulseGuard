{
  "name": "pulseguard-ai",
  "version": "1.0.0",
  "description": "PulseGuard AI - Secure Real-Time Video & Audio Communication Platform",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "npm run build --prefix client",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "backend:python": "backend\\venv\\Scripts\\uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload",
    "backend:test": "backend\\venv\\Scripts\\pytest backend -v",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "dev:all": "concurrently \"npm run server\" \"npm run client\" \"npm run backend:python\"",
    "install:all": "npm install --prefix server && npm install --prefix client"
  },
  "keywords": [
    "webrtc",
    "socket.io",
    "pulseguard",
    "ai-security",
    "liveness-detection",
    "deepfake-defense"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
