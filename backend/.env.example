# PulseGuard AI — Python Backend Configuration
APP_NAME="PulseGuard AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
